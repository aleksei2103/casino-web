        /* Кнопки и Сетка */
        .btn-main { background: var(--gold); color: #000; border: none; width: 100%; padding: 18px; border-radius: 18px; font-weight: 800; font-size: 16px; margin: 8px 0; box-shadow: 0 5px 15px rgba(255,140,0,0.2); }
