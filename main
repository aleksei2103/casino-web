<div id="slots-screen" class="screen">
    <h2 style="text-align: center; margin-bottom: 0;">PREMIUM SLOTS</h2>
    <div class="reels">
        <div id="r1" class="reel">💎</div>
        <div id="r2" class="reel">💎</div>
        <div id="r3" class="reel">💎</div>
    </div>
    <button class="btn-main" onclick="playSlots()">КРУТИТЬ (100)</button>
    <button class="btn-main btn-back" onclick="nav('lobby')">НАЗАД В ЛОББИ</button>
</div>

<div id="mines-screen" class="screen">
    <h2 style="text-align: center; margin-bottom: 5px;">MINES</h2>
    <div id="m-status" style="text-align:center; color: #ffcf1b; font-weight: 700; margin-bottom:10px">СТАВКА: 100 | МНОЖИТЕЛЬ: x1.00</div>
    <div id="m-grid" class="mines-grid"></div>
    <button id="m-btn" class="btn-main" onclick="startMines()">ИГРАТЬ (100)</button>
    <button class="btn-main btn-back" onclick="nav('lobby')">НАЗАД В ЛОББИ</button>
</div>

<div id="crash-screen" class="screen">
    <h2 style="text-align: center; margin-bottom: 15px;">CRASH ROCKET</h2>
    <div class="glass crash-area">
        <div id="crash-mult" style="font-size: 48px; font-weight: 900;">1.00x</div>
        <div id="crash-rocket">🚀</div>
    </div>
    <button id="c-btn" class="btn-main" onclick="toggleCrash()">СТАВКА (100)</button>
    <button class="btn-main btn-back" onclick="nav('lobby')">НАЗАД В ЛОББИ</button>
