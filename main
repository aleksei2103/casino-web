<script>
    let tg = window.Telegram.WebApp;
    tg.expand();
    let balance = 1000;
    const symbols = ['💎', '7️⃣', '🍒', '💰', '🍀'];

    function nav(id) {
        document.querySelectorAll('.screen').forEach(s => s.style.display = 'none');
        document.getElementById(id + (id==='lobby'||id==='profile'?'':'-screen')).style.display = 'block';
        updateBalanceDisplay();
        tg.HapticFeedback.impactOccurred('light');
    }

    function updateBalanceDisplay() {
        document.getElementById('main-bal').innerText = balance.toFixed(2);
    }

    // ЛОГИКА СЛОТОВ
    function playSlots() {
        if(balance < 100) return;
        balance -= 100; updateBalanceDisplay();
        const rs = [document.getElementById('r1'), document.getElementById('r2'), document.getElementById('r3')];
        rs.forEach(r => r.classList.add('spinning'));
        tg.HapticFeedback.impactOccurred('heavy');

        setTimeout(() => {
            let res = [];
            rs.forEach((r, i) => {
                setTimeout(() => {
                    r.classList.remove('spinning');
                    let s = symbols[Math.floor(Math.random()*symbols.length)];
                    r.innerText = s; res.push(s);
                    tg.HapticFeedback.impactOccurred('medium');
                    if(res.length === 3) {
                        if(res[0]===res[1] && res[1]===res[2]) balance += 1200;
                        else if(res[0]===res[1] || res[1]===res[2] || res[0]===res[2]) balance += 150;
                        updateBalanceDisplay();
                        tg.HapticFeedback.notificationOccurred('success');
                    }
                }, i*400);
            });
        }, 1000);
    }

    // ЛОГИКА МИН
    let mActive = false, mines = [], revealed = 0;
    function startMines() {
        const btn = document.getElementById('m-btn');
        if(mActive) { 
            let win = 100 * (1 + revealed * 0.25);
            balance += win; updateBalanceDisplay();
            tg.HapticFeedback.notificationOccurred('success');
            endMines(`ВЫИГРЫШ: +${win.toFixed(0)}`); 
            return; 
        }
        if(balance < 100) return;
        balance -= 100; updateBalanceDisplay();
        mActive = true; revealed = 0; mines = [];
        
        while(mines.length < 3) { 
            let r = Math.floor(Math.random()*25); 
            if(!mines.includes(r)) mines.push(r); 
        }
        
        const g = document.getElementById('m-grid'); g.innerHTML = '';
        for(let i=0; i<25; i++) {
            let c = document.createElement('div'); c.className = 'mine-cell glass';
            c.onclick = () => {
                if(!mActive || c.innerText !== '') return;
                if(mines.includes(i)) { 
                    c.innerText = '💣'; c.style.background = 'var(--red)'; 
                    tg.HapticFeedback.notificationOccurred('error');
                    endMines('БОМБА! ПРОИГРЫШ'); 
                } else { 
                    c.innerText = '💎'; c.style.background = 'var(--green)'; revealed++; 
                    document.getElementById('m-status').innerText = `МНОЖИТЕЛЬ: x${(1 + revealed*0.25).toFixed(2)}`; 
                    tg.HapticFeedback.impactOccurred('medium');
                }
            };
            g.appendChild(c);
        }
        btn.innerText = 'ЗАБРАТЬ ДЕНЬГИ';
    }
    function endMines(text) { mActive = false; document.getElementById('m-status').innerText = text; document.getElementById('m-btn').innerText = 'ИГРАТЬ СНОВА (100)'; }

    // ЛОГИКА КРАША
    let crashInterval, crashVal = 1.0, isCrashRunning = false;
    function toggleCrash() {
        const btn = document.getElementById('c-btn');
        if (isCrashRunning) {
            clearInterval(crashInterval);
            let win = 100 * crashVal;
            balance += win; updateBalanceDisplay();
            tg.HapticFeedback.notificationOccurred('success');
            btn.innerText = `ЗАБРАНО: +${win.toFixed(0)}`;
            isCrashRunning = false;
            setTimeout(() => { resetCrashUI(); }, 1500);
            return;
        }
        if(balance < 100) return;
        balance -= 100; updateBalanceDisplay();
        isCrashRunning = true; crashVal = 1.0;
        let limit = Math.random() * 4 + 1.1;
        btn.innerText = 'ВЫВЕСТИ ДЕНЬГИ';
        
        const rocket = document.getElementById('crash-rocket');
        crashInterval = setInterval(() => {
            crashVal += 0.04;
            document.getElementById('crash-mult').innerText = crashVal.toFixed(2) + 'x';
            rocket.style.bottom = (20 + (crashVal * 20)) + 'px';
            rocket.style.left = (20 + (crashVal * 25)) + 'px';
            
            if (crashVal >= limit) {
                clearInterval(crashInterval);
                isCrashRunning = false;
                document.getElementById('crash-mult').innerText = 'ВЗРЫВ!';
                tg.HapticFeedback.notificationOccurred('error');
                setTimeout(() => { resetCrashUI(); }, 1500);
            }
        }, 100);
    }
    function resetCrashUI() {
        document.getElementById('crash-mult').innerText = '1.00x';
        document.getElementById('c-btn').innerText = 'СТАВКА (100)';
        const rocket = document.getElementById('crash-rocket');
        rocket.style.bottom = '20px'; rocket.style.left = '20px';
    }
</script>
</body>
</html>
